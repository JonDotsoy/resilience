{
  "name": "@jondotsoy/resilience",
  "version": "0.1.2",
  "description": "Run a function with retries and cancellation through AbortSignal.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "pack": "npm run build && npm pack ./dist"
  },
  "keywords": [
    "resilience",
    "retry",
    "backoff",
    "exponential-backoff",
    "circuit-breaker",
    "bulkhead",
    "throttle",
    "rate-limit",
    "timeout",
    "abort",
    "abortsignal",
    "abort-controller",
    "fallback",
    "cache",
    "dedupe",
    "fault-tolerance",
    "fetch",
    "typescript"
  ],
  "author": {
    "name": "Jonathan Delgado",
    "email": "hi@john.soy",
    "url": "https://john.soy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonDotsoy/resilience.git"
  },
  "homepage": "https://github.com/JonDotsoy/resilience#readme",
  "bugs": {
    "url": "https://github.com/JonDotsoy/resilience/issues"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
