{
  "name": "@jondotsoy/resilience",
  "version": "0.1.0",
  "description": "Ejecuta una función con reintentos y cancelación vía AbortSignal.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "pack": "npm run build && npm pack ./dist"
  },
  "keywords": [
    "retry",
    "resilience",
    "abort",
    "signal",
    "fetch"
  ],
  "author": "JonDotsoy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonDotsoy/resilience.git"
  },
  "homepage": "https://github.com/JonDotsoy/resilience#readme",
  "bugs": {
    "url": "https://github.com/JonDotsoy/resilience/issues"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
